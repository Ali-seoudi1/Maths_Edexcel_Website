NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Exact bucket name from Firebase Console > Storage, for example:
# your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin SDK credentials from a Firebase service account.
# FIREBASE_PROJECT_ID can match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only email provider configuration.
RESEND_API_KEY=
MAIL_FROM=
APP_URL=
TEACHER_NAME=

# Optional secret used to protect scheduled cron endpoints.
CRON_SECRET=
